  }
  .recipe-ingredients {
    font-size: 10;
    color: rgba(200, 180, 255, 0.6);
  }
  .close-btn {
    padding: 8;
    background-color: rgba(120, 60, 200, 0.25);
    border-radius: 6;
    align-items: center;
    cursor: pointer;
    margin-top: 4;
  }
  .close-text {
    font-size: 14;
    color: #e0c0ff;
  }
</style>
