<style>
  .root {
    flex-direction: column;
    padding: 18;
    gap: 5;
    background-color: rgba(10, 5, 25, 0.94);
    border-radius: 14;
    border-color: rgba(180, 100, 255, 0.4);
    border-width: 2;
    width: 360;
  }
  .header {
    font-size: 22;
    color: #d4a0ff;
    margin-bottom: 4;
    align-items: center;
  }
  .recipe-row {
    flex-direction: row;
    align-items: center;
    gap: 6;
    padding: 5;
    background-color: rgba(120, 60, 200, 0.12);
    border-radius: 5;
  }
  .recipe-dot {
    width: 12;
    height: 12;
