<style>
  .root {
    flex-direction: column;
    align-items: center;
    padding: 32;
    gap: 14;
    background-color: rgba(10, 5, 25, 0.94);
    border-radius: 16;
    border-color: rgba(180, 100, 255, 0.4);
    border-width: 2;
    width: 340;
  }
  .title {
    font-size: 36;
    color: #d4a0ff;
    margin-bottom: 4;
  }
  .subtitle {
    font-size: 14;
    color: rgba(200, 160, 255, 0.6);
    margin-bottom: 8;
  }
  .info-row {
    flex-direction: row;
    gap: 24;
    align-items: center;
    margin-bottom: 6;
  }
  .info-label {
    font-size: 11;
    color: rgba(200, 160, 255, 0.4);
  }
  .info-val {
    font-size: 13;
    color: #e0c0ff;
  }
  .btn {
    padding: 14;
    background-color: rgba(120, 60, 200, 0.25);
    border-radius: 8;
    border-color: rgba(180, 100, 255, 0.3);
    border-width: 1;
    width: 260;
    align-items: center;
    cursor: pointer;
  }
  .btn-text {
    font-size: 18;
    color: #e0c0ff;
  }
  .highscore-label {
    font-size: 12;
    color: rgba(200, 160, 255, 0.5);
    margin-top: 4;
  }
</style>
<Panel class="root">
  <div class="title" id="title">NEON ALCHEMY</div>
  <div class="subtitle">Potion Brewing Arcade</div>
  <div class="info-row">
    <div class="info-label">11 INGREDIENTS</div>
    <div class="info-label">11 RECIPES</div>
    <div class="info-label">3 POWER-UPS</div>
  </div>
  <div class="btn" id="btn-play">
    <div class="btn-text">BREW</div>
  </div>
  <div class="btn" id="btn-recipes">
    <div class="btn-text">RECIPE BOOK</div>
  </div>
  <div class="highscore-label" id="highscore">HIGH SCORE: 0</div>
  <div class="info-val" id="best-wave"></div>
</Panel>
